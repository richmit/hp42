0                    @@@@ 0 MeRSC
X=Y?
"μ="
R↓                   @@@@ MeRSC
1                    @@@@ 1 MeRSC
X=Y?
"MR="
R↓                   @@@@ MeRSC
2                    @@@@ 2 MeRSC
X=Y?
"Q2="
RTN

